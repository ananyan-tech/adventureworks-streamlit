# Copy this file to .streamlit/secrets.toml for local execution only.
# Never commit the real secrets file.
SNOWFLAKE_DATABASE = "ADVENTURE_WORKS_PROD"
SNOWFLAKE_SCHEMA = "MARTS"

[connections.snowflake]
account = "YOUR_ACCOUNT"
user = "YOUR_USER"
authenticator = "externalbrowser"
role = "YOUR_READ_ONLY_ROLE"
warehouse = "YOUR_WAREHOUSE"
database = "ADVENTURE_WORKS_PROD"
schema = "MARTS"
